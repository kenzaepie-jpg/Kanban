# Copy this file to .env and fill in your MySQL details.

# MySQL connection. The database is created automatically if it doesn't exist.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=gostudy

# Port for the API server (the Vite dev server proxies /api to it)
PORT=4000

# Optional
# SESSION_DAYS=30
# UPLOAD_DIR=uploads
# MAX_UPLOAD_MB=25

# Set to true when serving over HTTPS
# COOKIE_SECURE=true
